# ==============================================================================
# Sumit Rathor Portfolio - Environment Configuration
# ==============================================================================
# Instructions:
# 1. For local development, copy this file to `.env` or `.env.local`
# 2. For production deployment on Vercel:
#    Go to Vercel Project Settings -> Environment Variables and configure each key.
# ==============================================================================

# [Contact Form - Serverless Email Dispatch]
# Provider: Resend (https://resend.com)
# Sign up at resend.com, generate an API key from the dashboard, and paste below.
# If unset, the /api/contact endpoint gracefully returns an unconfigured status
# and provides users with a direct mailto fallback so no messages are lost.
RESEND_API_KEY=re_your_api_key_here

# The verified sender email registered in your Resend account (e.g. onboarding@resend.dev or your custom domain)
CONTACT_SENDER_EMAIL=onboarding@resend.dev

# The destination email address where incoming contact form inquiries should be delivered
CONTACT_RECEIVER_EMAIL=sumitrathor142272@gmail.com

# [Analytics]
# Google Analytics 4 Measurement ID (optional)
# e.g., G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
